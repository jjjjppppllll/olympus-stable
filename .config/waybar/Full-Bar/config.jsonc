{
    "layer": "top",
    "position": "top",
    "margin-top": 4,
    "margin-left": 6,
    "margin-right": 6,
    "height": 40,
    "spacing": 8, 
    "modules-left": ["custom/launcher", "hyprland/window"],
    "modules-center": [
        "cpu", 
        "memory", 
        "mpris",
        "temperature",
        "custom/cava",
        "hyprland/workspaces", 
        "clock",
],
    "modules-right": ["custom/keyboard", "network", "bluetooth", "pulseaudio", "power-profiles-daemon", "battery", "custom/power"],

    "custom/launcher": {
        "format": "󰣇",
        "on-click": "rofi -show drun",
        "tooltip": false
    },

    "hyprland/window": {
        "format": "Desktop\n{initialTitle}",
        "max-length": 20
    },

    "cpu": {
        "interval": 2,
        "format": "󰻠 {usage}%",
        "states": { "critical": 80 }
    },

    "memory": {
        "interval": 5,
        "format": "󰍛 {percentage}%"
    },

    "mpris": {
        "format": "󰎆 {title}",
        "max-length": 40
    },
    
    "temperature": {
        "thermal-zone": 0,
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""],
        "tooltip": false
    },

    "custom/cava": { "exec": "waybar-cava", "format": "{}" },

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "all-outputs": true,
        "format-icons": {
            "active": "",
            "default": ""
        },
        "persistent-workspaces": { "*": [1, 2, 3, 4, 5, 6] }
    },

"clock": {
    "locale": "fr_FR.UTF-8",
    "format": "{:%H:%M · %d/%m}", 
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
        "mode"          : "month",
        "on-scroll"     : 1,
        "format": {
            "months":     "<span color='#a1cafd'><b>{}</b></span>",
            "days":       "<span color='#e1e2e8'><b>{}</b></span>",
            "weekdays":   "<span color='#d7bee4'><b>{}</b></span>",
            "today":      "<span color='#ffb4ab'><b><u>{}</u></b></span>"
        }
    }
},

"power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Profil : {profile}",
    "format-icons": {
        "default": "󰾅",
        "performance": "󰓅",
        "balanced": "󰾅",
        "power-saver": "󰌪"
    }
},

    "battery": { 
        "format": "{icon} {capacity}%", 
        "format-icons": ["", "", "", "", ""] 
    },

    "custom/power": { "format": "", "on-click": "wlogout" },

"network": { 
        "format-wifi": "", // On garde le nom du réseau {essid}
        "format-ethernet": "󰈀", 
        "format-disconnected": "󰖪",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "", // État activé mais non connecté
        "format-disabled": "󰂲", // Désactivé
        "format-connected": "󰂱", // Connecté (l'icône change)
        // "format-connected-battery": "󰂱 {device_battery_percentage}%", // Optionnel : affiche la pile si un casque est connecté
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connecté(s)",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connecté(s)\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": " Mute",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "custom/keyboard": {
    "exec": "hyprctl getoption input:kb_layout | grep 'str' | awk '{print $2}' | sed 's/\"//g;s/fr/FR/;s/us/US/'",
    "interval": 1,
    "on-click": "~/.scripts/toggle-keyboard.sh",
    "tooltip": false
}
    
}
