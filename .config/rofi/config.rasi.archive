/**
 * ATHENA — ROFI LAUNCHER CONFIG
 */

configuration {
    show-icons:         true;
    icon-theme:         "Papirus-Dark";
    font:               "JetBrainsMono Nerd Font 18";
    display-drun:       " Apps";
    display-run:        " Run";
    display-clipboard:  "󰅌 Clip";
    kb-cancel:              "Escape";
    kb-remove-char-back:    "BackSpace,Shift+BackSpace";
    kb-accept-entry:        "Return,KP_Enter";
    kb-custom-1:            "Alt+u";
    kb-custom-2:            "Alt+y";
    kb-custom-3:            "Alt+t";
    scroll-method:          0;
    click-to-exit:          true;
}

@import "colors.rasi"

* {
    var-win-bg:           @surface;
    var-input-bg:         @surface-container-high;
    var-urgent-bg:        @error-container;
    var-active-bg:        @primary;
    var-message-bg:       @surface-container;
    var-text-def:         @on-surface;
    var-text-dim:         @on-surface-variant;
    var-text-urgent:      @on-error-container;
    var-text-active:      @on-primary;
    var-border:           @outline;
    background-color:     @var-win-bg;
    text-color:           @var-text-def;
    border-color:         @var-border;
    normal-background:            transparent;
    normal-foreground:            @var-text-def;
    alternate-normal-background:  transparent;
    alternate-normal-foreground:  @var-text-def;
    selected-normal-background:   @var-active-bg;
    selected-normal-foreground:   @var-text-active;
    active-background:            @var-active-bg;
    active-foreground:            @var-text-active;
    urgent-background:            @var-urgent-bg;
    urgent-foreground:            @var-text-urgent;
    selected-urgent-background:   @var-urgent-bg;
    selected-urgent-foreground:   @var-text-urgent;
}

window {
    location: center; anchor: center; width: 25%;
    background-color: @var-win-bg;
    border: 2px; border-radius: 12px; padding: 20px;
}
mainbox {
    children: [ inputbar, message, listview ];
    spacing: 15px; background-color: transparent;
}
inputbar {
    children: [ prompt, entry ]; spacing: 10px;
    padding: 12px; border-radius: 8px;
    background-color: @var-input-bg;
}
prompt { background-color: inherit; text-color: @var-text-dim; }
entry  { placeholder: "Rechercher..."; placeholder-color: @var-text-dim; background-color: inherit; }
listview { columns: 1; lines: 6; cycle: true; scrollbar: false; spacing: 8px; fixed-height: false; background-color: transparent; }
element { padding: 8px 12px; border-radius: 8px; cursor: pointer; spacing: 6px; }
element-icon { size: 1.2em; vertical-align: 0.5; background-color: transparent; }
element-text { vertical-align: 0.5; background-color: transparent; highlight: bold underline; }
element normal.normal   { background-color: @normal-background;           text-color: @normal-foreground; }
element alternate.normal{ background-color: @alternate-normal-background; text-color: @alternate-normal-foreground; }
element selected.normal { background-color: @selected-normal-background;  text-color: @selected-normal-foreground; }
element normal.urgent   { background-color: @urgent-background;           text-color: @urgent-foreground; }
element selected.urgent { background-color: @selected-urgent-background;  text-color: @selected-urgent-foreground; }