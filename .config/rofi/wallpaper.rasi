/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃                                                                  ┃
 * ┃      ATHENA SIDENAR CONFIG                                       ┃
 * ┃                                                                  ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */

@import "colors.rasi"

configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      GENERAL CONFIGURATION                                       ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
configuration {
    modi:                        "drun";
    show-icons:                  true;
    drun-display-format:         "{name}";
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      GLOBAL VARIABLES & SETTINGS                                 ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
* {
    background-color:            transparent;
    text-color:                  @on-surface;
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      WINDOW LAYOUT                                               ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
window {
    anchor:                      west;
    location:                    west;
    width:                       600px;
    height:                      98%;
    x-offset:                    10px;
    y-offset:                    0px;
    background-color:            @surface-container-alpha;
    border:                      0px;
    border-radius:               24px;
    border-color:                @outline;
}

mainbox {
    spacing:                     10px;     
    padding:                     15px;
    children:                    [ "inputbar", "listview" ];
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      INPUT BAR                                                   ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
inputbar {
    padding:                     10px;
    margin:                      0px 0px 5px 0px;
    background-color:            @surface-container-high;
    border-radius:               12px;
    children:                    [ "entry" ];
}

entry {
    placeholder:                 "Search...";
    placeholder-color:           @on-surface-variant;
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      LIST VIEW                                                   ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
listview {
    columns:                     2;
    lines:                       5;
    spacing:                     15px;
    cycle:                       true;
    fixed-height:                false;
    scrollbar:                   false;
    layout:                      vertical;
}

/**
 * ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 * ┃      ELEMENT STYLING                                             ┃
 * ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 */
element {
    orientation:                 vertical;
    padding:                     10px;
    border-radius:               15px;
}

element selected {
    background-color:            @surface-container-high;
    border:                      2px;
    border-color:                @primary;
}

element-icon {
    size:                        200px; 
}

element-text {
    horizontal-align:            0.5;
    font:                        "JetBrainsMono Nerd Font 10";
}
